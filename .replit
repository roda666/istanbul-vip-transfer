modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GitHub Auto-Sync"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "overflow-guard"

[[workflows.workflow]]
name = "GitHub Auto-Sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh scripts/github-sync.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/istanbul-vip-transfer && pnpm run build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "overflow-guard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/istanbul-vip-transfer && npx playwright test tests/overflow-guard.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss", "atk", "at-spi2-atk", "dbus", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "mesa", "xorg.libxcb", "libxkbcommon", "alsa-lib", "at-spi2-core", "libgbm", "chromium", "cups", "cairo", "pango", "imagemagick"]

[objectStorage]
defaultBucketID = "replit-objstore-256c4b02-b655-41f8-bd7d-03afce0d36cb"

[userenv]

[userenv.shared]
STUDIO_SCHEDULER_ENABLED = "true"
CRON_SECRET = "6d2704cf9986f508a9e761638387503e1208dd0b31020cde9132add6ae5e9441"
OPENAI_IMAGE_MODEL = "gpt-image-2"
