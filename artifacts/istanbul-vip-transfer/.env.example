# ─────────────────────────────────────────────────────────────────────────────
# Istanbul VIP Transfer — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file with real secrets to version control.
# On Replit, set these via the Secrets manager instead of a .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Replit managed DB or external Postgres).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/istanbul_vip_transfer

# ── Authentication & Session ──────────────────────────────────────────────────

# Secret used to sign iron-session cookies.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Secret for general server-side session signing (if separate from AUTH_SECRET).
SESSION_SECRET=replace-with-another-long-random-string

# ── Admin ─────────────────────────────────────────────────────────────────────

# E-mail address of the primary administrator account.
ADMIN_EMAIL=admin@example.com

# ── OpenAI / AI Integration ───────────────────────────────────────────────────

# Standard OpenAI API key — used as fallback when AI Integrations proxy is
# not configured (chatbot, translations, AI Studio).
OPENAI_API_KEY=sk-...

# Replit AI Integrations proxy credentials (preferred over OPENAI_API_KEY).
# Leave blank if using a direct OpenAI key above.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Optional: override the default model for each subsystem.
# Defaults to gpt-4o-mini if not set.
OPENAI_CHATBOT_MODEL=gpt-4o-mini
OPENAI_CONTENT_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# ── E-mail / SMTP ─────────────────────────────────────────────────────────────

# SMTP credentials for transactional e-mail (booking notifications, etc.).
# If left blank, e-mail sending is disabled and settings can be configured
# via the admin panel (stored encrypted in the database).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (TLS), false for STARTTLS
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Istanbul VIP Transfer <noreply@example.com>"

# AES-256-GCM key used to encrypt the SMTP password stored in the database.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=replace-with-64-hex-chars-32-bytes

# ── Object Storage (Replit / GCS) ─────────────────────────────────────────────

# Replit Object Storage bucket ID for admin-uploaded images and media.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id

# Directory prefix for private (non-public) objects within the bucket.
PRIVATE_OBJECT_DIR=private/

# Colon-separated list of GCS path prefixes that are publicly readable.
# Example: "public/:uploads/"
PUBLIC_OBJECT_SEARCH_PATHS=public/

# ── Google Search Console (optional) ─────────────────────────────────────────

# OAuth2 credentials for Google Search Console integration (AI Studio SEO).
# Leave blank to disable GSC features in the admin panel.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# ── Keyword Research (optional) ───────────────────────────────────────────────

# API key for the keyword research provider used by AI Studio.
# Leave blank to disable keyword suggestion features.
KEYWORD_PROVIDER_API_KEY=

# ── Scheduler (optional) ──────────────────────────────────────────────────────

# Set to "true" to enable the background AI content scheduler.
# Disabled by default; safe to leave blank in development.
NEXT_PUBLIC_SCHEDULER_ENABLED=false
STUDIO_SCHEDULER_ENABLED=false
