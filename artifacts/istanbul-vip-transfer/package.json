{
  "name": "@workspace/istanbul-vip-transfer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "check:page-meta": "tsx scripts/check-page-meta.ts",
    "check:locale-contamination": "node scripts/check-locale-contamination.mjs",
    "check:toll-fee-mentions": "node scripts/check-toll-fee-mentions.mjs",
    "test:toll-fee-mentions": "node scripts/test-check-toll-fee-mentions.mjs",
    "check:toll-customer-leak-static": "node scripts/check-toll-customer-leak-static.mjs",
    "check:toll-customer-leak-live": "node scripts/check-toll-customer-leak-live.mjs",
    "seed:toll-pricing-data": "node scripts/seed-toll-pricing-data.mjs",
    "generate:page-meta": "tsx scripts/generate-page-meta.ts",
    "test:admin-route-map": "tsx scripts/test-admin-route-map.ts",
    "prebuild": "tsx scripts/check-page-meta.ts && pnpm test:admin-route-map && pnpm check:toll-fee-mentions && pnpm check:toll-customer-leak-static && pnpm generate:og-card",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && tsx db/seed-blog-posts.ts && tsx db/seed-new-service-translations-static.ts && tsx db/seed-transfer-routes.ts && tsx db/seed-route-pages.ts && tsx db/seed-service-categories.ts && tsx db/seed-fleet.ts",
    "db:push": "drizzle-kit push",
    "generate:og-card": "bash scripts/generate-og-card.sh",
    "generate:og-service-cards": "bash scripts/generate-service-og-cards.sh",
    "generate:hero-images": "node scripts/generate-hero-images.mjs",
    "generate:hero-images:blog": "node scripts/generate-hero-images.mjs --target=blog",
    "generate:hero-images:blog:dry-run": "node scripts/generate-hero-images.mjs --target=blog --dry-run",
    "create-admin": "tsx scripts/create-admin.ts",
    "reset-admin-password": "tsx scripts/reset-admin-password.ts",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:admin-auth": "tsx scripts/test-admin-authorization.ts",
    "test:admin-auth:e2e": "tsx scripts/test-admin-authorization-e2e.ts",
    "test:email-links": "NODE_OPTIONS='--conditions=react-server' tsx scripts/test-email-link-safety.ts",
    "test:perf": "tsx scripts/perf-check.ts",
    "test:perf:browser": "playwright test tests/perf.spec.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "iron-session": "^8.0.4",
    "nodemailer": "^9.0.5",
    "openai": "^6.49.0",
    "postgres": "^3.4.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "twitter-api-v2": "^1.29.1",
    "web-vitals": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/react-query": "catalog:",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "chrome-launcher": "^1.2.1",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "framer-motion": "catalog:",
    "lighthouse": "^13.4.1",
    "lucide-react": "catalog:",
    "next": "^15.3.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.55.0",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vitest": "^4.1.0",
    "zod": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
